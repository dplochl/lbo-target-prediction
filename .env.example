# Copy to .env and fill in. .env is gitignored.
# Anthropic API key, needed only for the LLM stages of the pipeline (src/05, 06, 07, 09, 10).
ANTHROPIC_API_KEY=
# The SEC requires an identifying User-Agent (project name + contact email) on every EDGAR request.
SEC_USER_AGENT="YourProject/1.0 (your email address)"
